HOST=127.0.0.1
PORT=8899
# Optional compatibility token for Basic/Bearer clients.
# CODEX_WEBUI_ACCESS_TOKEN=replace-with-a-long-random-secret

# Configured authentication applies to localhost too. Non-localhost listeners require authentication.
# Initialize a managed password locally with HOST=127.0.0.1 bun run server.ts --setup-password
# before exposing the service, or set a password/token below.
# CODEX_WEBUI_PASSWORD=replace-with-a-long-random-password
# Optional path for the salted managed password credential.
# CODEX_WEBUI_AUTH_STORE=/path/to/.codex/codex-webui-auth.json
# Defaults to the repository directory.
CODEX_WEBUI_CWD=/path/to/your/project
# Undo/Reapply is restricted to this exact Git repository root by default.
CODEX_WEBUI_REVIEW_ROOT=/path/to/your/project
# Optional custom Codex state/auth locations.
# CODEX_HOME=/path/to/.codex
# CODEX_AUTH_PATH=/path/to/.codex/auth.json
# Connect to the same daemon as the SSH CLI (same user and CODEX_HOME).
# auto uses an existing control socket; shared requires it; isolated starts a separate app-server.
# CODEX_WEBUI_APP_SERVER_MODE=auto
# Optional custom socket path. Defaults to $CODEX_HOME/app-server-control/app-server-control.sock.
# CODEX_WEBUI_APP_SERVER_SOCKET=/path/to/app-server-control.sock
# Optional browser binary for Playwright scripts.
PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome-or-edge

# Optional ntfy push notifications on task completion.
# Set a topic to enable (subscribe to the same topic in the ntfy app or at https://ntfy.sh).
# CODEX_WEBUI_NTFY_TOPIC=my-codex-topic
# Optional custom ntfy server URL (defaults to https://ntfy.sh).
# CODEX_WEBUI_NTFY_URL=https://ntfy.sh

# Multi-user mode is disabled by default. Enable only after provisioning the
# users root and auth database; each authenticated user gets an isolated worker.
# CODEX_WEBUI_MULTI_USER=true
# Base directory for per-user workspaces, Codex homes, uploads and metadata.
# CODEX_WEBUI_MULTI_USER_ROOT=/srv/codex-webui
# Codex credential mode: shared (default) or per-user.
# CODEX_WEBUI_CODEX_ACCOUNT_MODE=shared
# Optional shared auth.json path. Without it, CODEX_HOME/auth.json is copied
# into each worker's private CODEX_HOME when shared mode starts.
# CODEX_WEBUI_SHARED_CODEX_CREDENTIAL_REF=/etc/codex-webui/shared-auth.json
# Optional explicit paths for the multi-user control database and users directory.
# CODEX_WEBUI_AUTH_DATABASE=/srv/codex-webui/control/auth.sqlite
# CODEX_WEBUI_USERS_ROOT=/srv/codex-webui/users
# Single-user migration: set CODEX_WEBUI_MIGRATION_PASSWORD only for the
# one-shot `bun run migrate:single-user` command, then remove it.

# Docker Compose settings (optional; host paths are intentionally generic).
# PUID=1000
# PGID=1000
# WEBUI_BIND_IP=127.0.0.1
# CODEX_HOME_HOST=/home/USERNAME/.codex
# CODEX_BIN=/home/USERNAME/.codex/packages/standalone/releases/VERSION/bin/codex
# CONTAINER_HOME=/home/codex
# CONTAINER_CODEX_HOME=/home/codex/.codex
