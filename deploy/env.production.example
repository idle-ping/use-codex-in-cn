# Docker Compose 生产环境变量模板
# 用法：
#   1. cp deploy/env.production.example .env
#   2. 按注释修改后：docker compose up -d --build
# 变量与根目录 docker-compose.yml 一一对应，完整说明见 README「Docker」一节。

# WebUI 在宿主机上的绑定地址：保持 127.0.0.1，对外暴露交给反向代理
WEBUI_BIND_IP=127.0.0.1

# 宿主机 codex 可执行文件路径（which codex 的结果），容器内只读挂载
CODEX_BIN=/usr/bin/codex

# 宿主机 CODEX_HOME（包含 codex 登录凭据 auth.json 与 WebUI 密码文件）
CODEX_HOME_HOST=/home/YOUR_USER/.codex

# Undo/Reapply 允许影响的 git 仓库根目录（你的工作项目都放这下面）
CODEX_WEBUI_REVIEW_ROOT=/home/YOUR_USER/projects

# true：启动页不绑定默认项目，由页面选择
CODEX_WEBUI_PROJECTLESS=true

# 时区
TZ=Asia/Shanghai
